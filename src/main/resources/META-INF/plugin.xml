<idea-plugin>
  <!-- id must match PluginInfo.ID. It can still change freely until the first Marketplace release. -->
  <id>io.github.mrglasses.clawedui</id>
  <name>Clawed UI</name>
  <vendor url="https://github.com/mrGlasses">mrGlasses</vendor>
  <description><![CDATA[
    A visual interface for your own installed Claude Code CLI in RustRover: chat panel, diff review, selection
    sharing and diagnostics over Claude Code's IDE protocol. No Node.js needed, and the official Claude Code
    JetBrains plugin is optional.
    <p><b>Unofficial community plugin</b>, not affiliated with Anthropic or JetBrains.
    Claude Code can read, change and delete files and run commands within the permissions you approve:
    review every change and keep backups. Provided "as is", without warranty; the authors are not liable
    for data loss or any other damage. See DISCLAIMER.md and LICENSE in the source repository.</p>
  ]]></description>

  <!--
    Deliberately NO <depends> on com.anthropic.code.plugin.
    The official plugin is detected at runtime (compat/OfficialPluginDetector.kt),
    so this plugin installs and works with or without it.
  -->
  <depends>com.intellij.modules.platform</depends>
  <!-- Bundled with RustRover: lets `claude` in IDE terminals connect without /ide. -->
  <depends>org.jetbrains.plugins.terminal</depends>
  <!-- IDE 2026.2+ ships JCEF as a separate bundled plugin; older builds have it in the core. Optional so both load. -->
  <depends optional="true" config-file="claude-ui-jcef.xml">com.intellij.modules.jcef</depends>

  <extensions defaultExtensionNs="com.intellij">
    <!-- MetaClaudeService is a light service (@Service), so it is not registered here. -->
    <notificationGroup id="Clawed UI" displayType="BALLOON"/>
    <projectActivity implementation="dev.metaclaude.BridgeStartupActivity"/>
    <applicationConfigurable parentId="tools" instance="dev.metaclaude.settings.ClaudeUiConfigurable"
                             id="dev.metaclaude.settings" displayName="Clawed UI"/>
  </extensions>

  <extensions defaultExtensionNs="org.jetbrains.plugins.terminal">
    <localTerminalCustomizer implementation="dev.metaclaude.ClaudeTerminalCustomizer" order="last"/>
  </extensions>

  <actions>
    <action id="dev.metaclaude.StartSession" class="dev.metaclaude.StartSessionAction"
            text="New Claude Session" description="Open a Claude tab in the Terminal, connected to this IDE">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="dev.metaclaude.FocusClaude" class="dev.metaclaude.FocusClaudeAction"
            text="Toggle Focus: Editor / Claude"
            description="Jump between the editor and the Claude terminal tab (opens a session if none)">
      <keyboard-shortcut keymap="$default" first-keystroke="alt shift K"/>
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <!-- Phase 6 developer spike; removed when the chat panel lands. -->
    <action id="dev.metaclaude.StreamSpike" class="dev.metaclaude.spike.StreamSpikeAction"
            text="Clawed UI: Run Stream Spike (Dev)"
            description="Drive claude in stream-json mode and record the protocol to ~/.claude-meta/spike-*.log">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="dev.metaclaude.SendAtMention" class="dev.metaclaude.SendAtMentionAction"
            text="Send Selection to Claude"
            description="Insert an @-mention of the selected lines into the connected Claude session">
      <keyboard-shortcut keymap="$default" first-keystroke="alt K"/>
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
