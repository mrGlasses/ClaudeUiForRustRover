<!-- Loaded only when com.intellij.modules.jcef is present (optional dependency in plugin.xml). -->
<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="Claude Chat" anchor="right" secondary="false" icon="AllIcons.Toolwindows.ToolWindowMessages"
                factoryClass="dev.metaclaude.panel.ChatToolWindowFactory"/>
    <!-- Banner (Send my comments / Approve plan) on a plan opened from the chat panel. -->
    <editorNotificationProvider implementation="dev.metaclaude.panel.PlanNotificationProvider"/>
  </extensions>
</idea-plugin>
